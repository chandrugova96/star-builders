NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/star_builders_dev
CORS_ORIGINS=http://localhost:5173
# Set a randomly generated secret of at least 32 characters in your ignored .env.
JWT_SECRET=

# Combined hosting: serve frontend/dist from Express (false for Vite development).
SERVE_FRONTEND=false
# Enable only behind the single trusted ingress proxy used by Render.
TRUST_PROXY=0
# On Render, omit CORS_ORIGINS to use RENDER_EXTERNAL_URL automatically.
# For a custom domain, explicitly set CORS_ORIGINS to its exact HTTPS origin.
